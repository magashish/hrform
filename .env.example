APP_NAME="Onboarding Portal"
APP_ENV=local
APP_KEY=
# Must be false in production (it is also forced off when APP_ENV=production).
APP_DEBUG=true
APP_URL=http://localhost
# Timezone used when displaying dates (storage is always UTC). Pending client confirmation.
APP_DISPLAY_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# PostgreSQL recommended (MySQL 8 also supported). SQLite is fine for local trials.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=onboarding
DB_USERNAME=onboarding
DB_PASSWORD=

# HR sessions: 30-minute idle timeout, encrypted, cookie dies with the browser.
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_EXPIRE_ON_CLOSE=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Defaults to true when APP_ENV=production. Requires HTTPS.
# SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Comma-separated IPs/CIDRs of a TLS-terminating proxy/load balancer, or *.
TRUSTED_PROXIES=
# Enable only once HTTPS is permanent for this domain.
SECURITY_HSTS=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# WARNING: the "log" mailer writes full emails (including invitation and
# password-reset links) to the log. Use it only on a local machine.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="onboarding@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- HR accounts ---
HR_2FA_REQUIRED=true
# email = one-time code emailed at every sign-in (default); totp = authenticator app
HR_2FA_METHOD=email
HR_EMAIL_CODE_TTL_MINUTES=10
HR_PASSWORD_MIN_LENGTH=12
# Checks new passwords against Have I Been Pwned (needs outbound HTTPS).
HR_PASSWORD_CHECK_UNCOMPROMISED=false
HR_PASSWORD_RESET_EXPIRE=60
# Seconds before sensitive actions ask for the password again.
AUTH_PASSWORD_TIMEOUT=900

# --- Applicant invitations ---
INVITATION_EXPIRY_DAYS=7

# --- Audit ---
AUDIT_RECORD_IP=true
AUDIT_RECORD_USER_AGENT=true
AUDIT_RETENTION_DAYS=365

# --- Private document storage ---
# local: files under storage/app/private/documents (outside the web root).
# s3: a PRIVATE bucket with server-side encryption enabled.
DOCUMENTS_DRIVER=local
# DOCUMENTS_ROOT=/var/lib/onboarding/documents
DOCUMENTS_S3_KEY=
DOCUMENTS_S3_SECRET=
DOCUMENTS_S3_REGION=
DOCUMENTS_S3_BUCKET=
DOCUMENTS_S3_ENDPOINT=
DOCUMENTS_S3_PATH_STYLE=false
# EXPORTS_ROOT=/var/lib/onboarding/exports

# --- Local development only (ignored in production) ---
# Used by `php artisan db:seed` to create a development HR account.
DEV_HR_EMAIL=
DEV_HR_PASSWORD=
